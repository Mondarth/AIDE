{
  "name": "@mondarth/aide",
  "version": "0.0.0",
  "description": "AIDE, the Adventure Integrated Development Environment.",
  "author": "Ulenar of Mondarth",
  "license": "MIT",
  "type": "module",
  "homepage": "https://mondarth.github.io/AIDE/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mondarth/AIDE.git"
  },
  "bugs": {
    "url": "https://github.com/Mondarth/AIDE/issues"
  },
  "keywords": [
    "adventure",
    "ttrpg",
    "ide",
    "sveltekit",
    "electron"
  ],
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "main": "dist/host/electron/main.js",
  "bin": {
    "aide": "dist/host/cli.js"
  },
  "files": [
    "build",
    "dist/host",
    "!**/*.map"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "pnpm i18n:compile && svelte-kit sync && husky",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "dev": "vite dev",
    "build": "pnpm build:web && pnpm build:host",
    "build:web": "vite build",
    "build:host": "vite build --config vite.host.config.ts",
    "start": "node dist/host/cli.js",
    "typecheck": "svelte-kit sync && tsc --noEmit && tsc --noEmit -p host/tsconfig.json",
    "typecheck:fallback": "svelte-kit sync && tsc6 --noEmit && tsc6 --noEmit -p host/tsconfig.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit --project component",
    "test:stories": "vitest run --project storybook",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:coverage": "E2E_COVERAGE=1 pnpm build && E2E_COVERAGE=1 playwright test --project=chromium && node scripts/e2e-coverage-report.ts",
    "test:e2e:electron": "playwright test --project=electron",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "electron:dev": "pnpm build && electron .",
    "electron:pack": "electron-builder --dir --publish never",
    "electron:dist": "electron-builder --publish never",
    "docker:build": "docker build -t aide:local .",
    "docker:run": "docker run --rm -p 3000:3000 aide:local",
    "docs:api": "svelte-kit sync && typedoc",
    "build:docs": "pnpm docs:api && DOCS_UID=$(id -u) DOCS_GID=$(id -g) docker compose -f docs/compose.yaml run --rm --no-deps -T docs make html",
    "devserve:docs": "pnpm docs:api && DOCS_UID=$(id -u) DOCS_GID=$(id -g) docker compose -f docs/compose.yaml run --rm --service-ports docs make livehtml",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "commit": "cz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.28.0",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/sveltekit": "^10.6.2",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.4",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "monocart-coverage-reports": "^2.13.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-browser-svelte": "^3.1.0"
  }
}
